{
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "google",
        "detour": "proxy",
        "server": "8.8.8.8"
      },
      {
        "type": "https",
        "tag": "local",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "server": "google"
      }
    ]
  },
  "http_clients": [
    {
      "tag": "download-client",
      "version": 2,
      "detour": "proxy",
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "127.0.0.1",
      "listen_port": 1081
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "domain_resolver": "local",
      "server": "youer server ip/domian",
      "server_port": 443,
      "uuid": "your uuid",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "your sin",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "youer public key",
          "short_id": "youer short id"
        }
      }
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "google",
    "default_http_client": "download-client"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  }
}
